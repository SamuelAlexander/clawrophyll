# Copy to .env and fill in. .env is gitignored and is NOT shipped to the board;
# secrets go into ~/.nanobot/config.json on the UNO Q (see nanobot/config.example.json).

# --- Deployment (used by scripts/sync.sh) ---
# SSH target for the Arduino UNO Q. Set up a host alias in ~/.ssh/config or use user@host.
UNOQ_HOST=arduino@uno-q.local
# Absolute path on the board where the repo is deployed.
# Lives under ~/ArduinoApps so the app shows up in App Lab's "My Apps".
UNOQ_REMOTE_DIR=/home/arduino/ArduinoApps/clawrophyll
# Live nanobot workspace on the board (relative to the board user's home), where
# scripts/sync-workspace.sh pushes the agent's curated config. Default shown.
UNOQ_WORKSPACE_DIR=.nanobot/workspace

# --- LLM provider (referenced when generating config.json) ---
# Default provider is Anthropic Claude (multimodal). Gemini Flash is the alternate.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Telegram ---
# Bot token from @BotFather. Phil's only interface.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (from @userinfobot). Locks the bot to you --
# goes into channels.telegram.allowFrom. Do not leave the bot open to anyone.
TELEGRAM_ALLOWED_USER_ID=
